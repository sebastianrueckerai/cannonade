[node name="GunTest" type="Node3D"]
editor_description = "Gun bench. Columns sorted by vertex count, lowest on the left. To turn a gun, select its node 'gun' and rotate about Y. To tilt the barrel, expand 'gun', select 'barrel' and rotate about X: positive raises the muzzle. The red dot is projectile_spawn. The front row holds the five guns as the game ships them, each inside its square (D61). The flak turns and tilts as one part: select its 'guns' and rotate about X and Y. Models come from blender-ai pipeline/barrel.py."

