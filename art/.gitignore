# The art kit of Cannonade, copied from blender-ai on 2026-10-15. The game repo keeps binaries as plain git, so it
# commits only what a new art step needs: the anchors and inspirations, each model's final, source.blend, the run it is
# built from and that run's input views. The round images, the render previews and the runs and views no model was built
# from stay on disk here and versioned in blender-ai (Git LFS).

# secrets
.env
.env.*
!.env.example

# python
.venv/
__pycache__/

# Blender backups
*.blend[0-9]*
*.blend@

# intermediates rebuilt by meshsheet.py and barrel.py
game/assets/3d/*/previews/route-test/
game/assets/3d/*/previews/barrel/
game/assets/3d/*/previews/pieces/

# the loading screens, rebuilt by pipeline/storeset.py loading. The game's copies are in assets/art/ui/
game/assets/ui/loading/*.jpg

# history, on disk only
game/art-direction/rounds/**/*.png
game/art-direction/rounds/**/*.jpg
game/art-direction/rounds/**/*.jpeg
game/art-direction/rounds/**/*.webp
game/art-direction/rounds/**/*.mp4
game/assets/3d/*/previews/
game/assets/3d/*/raw/*
game/assets/3d/*/refs/*
!game/assets/3d/*/raw/*.json
!game/assets/3d/*/refs/*.json
!game/assets/3d/*/refs/prompts/

